# ==============================================================================
# Rezen Environment Configuration
# Copy this file to .env and adjust values as needed.
# ==============================================================================

# Application Environment: "production" or "development"
APP_ENV=production

# Enable debug mode for verbose logging (true / false)
APP_DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Display logs in the terminal console (true / false)
# Set to false in production to prevent terminal clutter; all logs are saved to LOG_FILE
LOG_TO_CONSOLE=false

# Path to the log file (relative to project root or absolute)
LOG_FILE=logs/rezen.log

# Maximum log file size in bytes before rotation (default: 10MB = 10485760)
LOG_MAX_BYTES=10485760

# Number of rotated backup log files to retain
LOG_BACKUP_COUNT=5

# Path to the SQLite database file
DB_PATH=rezen.db

# Screen capture backend: "auto" (default), "mss" (X11 / Windows), or "pipewire" (Wayland)
SCREEN_CAPTURE_BACKEND=auto

# Maximum capture resolution (frames are downscaled if larger)
SCREEN_CAPTURE_MAX_WIDTH=1280
SCREEN_CAPTURE_MAX_HEIGHT=720

# H.264 video streaming settings
SCREEN_STREAM_BITRATE=8000000
SCREEN_STREAM_PRESET=veryfast

# Internal queue sizes (increase if you experience dropped frames on slow hardware)
STREAM_QUEUE_MAX_SIZE=10000
STREAM_CHUNK_SIZE=16384
INPUT_STREAM_QUEUE_MAX_SIZE=10000
INPUT_RECEIVE_QUEUE_MAX_SIZE=10000
