/* Screen Styles - HomeScreen, BroadcastScreen, DiscoverScreen, ConnectingScreen */

HomeScreen, BroadcastScreen, DiscoverScreen, ConnectingScreen {
    align: center middle;
    height: 100%;
    width: 100%;
}

#welcome-card, #broadcast-card, #discover-card, #connecting-card {
    width: 70;
    height: auto;
    border: heavy $accent;
    background: $surface;
    padding: 1 2;
    align: center middle;
}

#welcome-title, #broadcast-title, #discover-title, #connecting-title {
    text-style: bold;
    color: $accent;
    content-align: center middle;
    margin-bottom: 1;
}

#welcome-subtitle, #broadcast-subtitle, #discover-subtitle, #connecting-subtitle {
    color: $text-muted;
    content-align: center middle;
    margin-bottom: 1;
}

#home-options {
    width: 100%;
    align: center middle;
    margin-top: 1;
}

#home-options Button {
    margin: 1 0;
    width: 32;
}

#broadcast-info {
    color: $text;
    content-align: center middle;
    margin: 1 0;
    padding: 1;
    border: dashed $accent;
}

#scan-status {
    color: $accent;
    content-align: center middle;
    margin-bottom: 1;
}

#device-list-container {
    height: 6;
    width: 100%;
    border: solid $accent;
    margin-bottom: 1;
    background: $panel;
}

#device-list-view {
    height: auto;
    width: 100%;
}

DeviceListItem {
    padding: 1 2;
    height: auto;
}

.device-item-title {
    text-style: bold;
    color: $accent;
}

.device-item-subtitle {
    color: $text-muted;
}

#discover-actions {
    width: 100%;
    height: auto;
    align: center middle;
}

#discover-actions Button {
    margin: 0 1;
}

/* ── ConnectingScreen ─────────────────────────────────────── */

#connecting-info {
    color: $text;
    content-align: center middle;
    margin: 1 0;
    padding: 1;
    border: dashed $accent;
}

#connecting-spinner {
    margin: 1 0;
    height: 1;
}

#connecting-status {
    color: $text-muted;
    content-align: center middle;
    margin-bottom: 1;
    text-wrap: wrap;
}

/* ── BroadcastScreen – Incoming request list ──────────────── */

#broadcast-requests-label {
    color: $text-muted;
    content-align: left middle;
    margin-top: 1;
}

#request-list-container {
    height: 5;
    width: 100%;
    border: solid $warning;
    margin-bottom: 1;
    background: $panel;
}

#request-list-view {
    height: auto;
    width: 100%;
}

RequestListItem {
    padding: 1 2;
    height: auto;
}

.request-item-title {
    text-style: bold;
    color: $warning;
}

.request-item-subtitle {
    color: $text-muted;
}

#broadcast-status {
    color: $success;
    content-align: center middle;
    margin: 0 0 1 0;
    text-wrap: wrap;
}
