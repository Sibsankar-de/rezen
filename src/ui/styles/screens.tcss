HomeScreen, BroadcastScreen, DiscoverScreen, ConnectingScreen, ConnectedScreen {
    align: center middle;
    height: 100%;
    width: 100%;
}

/* ── Home ─────────────────────────────────────────────────── */

#welcome-card {
    width: 56;
    height: auto;
    border: tall $accent;
    background: $surface;
    padding: 1 2;
    align: center middle;
}

#logo {
    color: $accent;
    text-align: center;
    content-align: center middle;
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

#welcome-subtitle {
    color: $text-muted;
    content-align: center middle;
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}

#home-options {
    width: 100%;
    height: auto;
    align: center middle;
    margin-top: 1;
}

#home-options Button {
    margin: 0 0 1 0;
    width: 36;
}

/* ── Other screens ────────────────────────────────────────── */

#broadcast-card, #discover-card, #connecting-card, #connected-card {
    width: 60;
    height: auto;
    border: tall $accent;
    background: $surface;
    padding: 0 2 1 2;
    align: center middle;
}

/* Top nav row: title + back button */
.card-nav {
    width: 100%;
    height: auto;
    align: left middle;
    padding: 1 0 0 0;
    margin-bottom: 1;
}

.card-nav-title {
    text-style: bold;
    color: $accent;
    width: 1fr;
    content-align: left middle;
}

.btn-back-small {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    background: transparent;
    color: $text-muted;
    padding: 0 1;
}

.btn-back-small:hover {
    color: $accent;
    background: $panel;
}

#broadcast-info, #connecting-info, #connected-info {
    color: $text;
    content-align: center middle;
    margin: 1 0;
    padding: 0 1;
    border: dashed $panel;
    text-align: center;
}

#broadcast-requests-label {
    color: $text-muted;
    margin-top: 1;
}

#request-list-container, #device-list-container {
    height: 5;
    width: 100%;
    border: solid $panel;
    margin-bottom: 1;
    background: $background;
}

#request-list-view, #device-list-view {
    height: auto;
    width: 100%;
}

RequestListItem, DeviceListItem {
    padding: 0 1;
    height: auto;
}

.request-item-title, .device-item-title {
    text-style: bold;
    color: $text;
}

.request-item-subtitle, .device-item-subtitle {
    color: $text-muted;
}

#broadcast-status {
    color: $success;
    content-align: center middle;
    text-align: center;
    margin: 1 0;
    text-wrap: wrap;
}

/* discover */
#scan-status {
    color: $accent;
    content-align: center middle;
    text-align: center;
    margin-bottom: 1;
}

#device-list-container {
    height: 7;
}

#discover-actions {
    width: 100%;
    height: auto;
    align: center middle;
    margin-top: 1;
}

#discover-actions Button {
    margin: 0 1;
}

/* connecting */
#connecting-spinner {
    margin: 1 0;
    height: 1;
}

#connecting-status {
    color: $text-muted;
    content-align: center middle;
    text-align: center;
    margin-bottom: 1;
    text-wrap: wrap;
}

/* connected */
#connected-status {
    color: $success;
    content-align: center middle;
    text-align: center;
    margin-bottom: 1;
    text-wrap: wrap;
}

#connected-actions {
    width: 100%;
    height: auto;
    align: center middle;
    margin-top: 1;
}

#btn-disconnect {
    background: $error;
    color: white;
    width: 32;
    border: none;
    text-style: bold;
}

#btn-disconnect:hover {
    background: #c0392b;
}

#btn-disconnect:focus {
    background: #e74c3c;
    border: tall #ff7675;
}
